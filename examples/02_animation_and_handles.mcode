SetPATH examples/animation_and_handles
import mc
import time
import math

mc.clear()
mc.mode("local", sigue=True)

ring = mc.circle(0, 1.5, 5, 1.0, plane="xz", segments=48, color="cyan", width=3)
marker = mc.box(-0.25, 1.1, 4.8, 0.25, 1.6, 5.2, color="magenta", fill=True, alpha=0.6)
trail = mc.polyline([[-2, 1.0], [-1, 1.5], [0, 1.0], [1, 1.5], [2, 1.0]], plane="xz", level=4.0, color="yellow", width=2)

step = 0
previous_x = 0
while step < 240:
    x = math.sin(step * 0.08) * 1.5
    delta = x - previous_x
    marker.move(delta, 0, 0)
    previous_x = x
    if step % 60 == 0:
        if (step // 60) % 2 == 0:
            ring.color("cyan")
        else:
            ring.color("lime")
    step += 1
    time.sleep(0.05)

print("Animacion terminada. Pulsa Ejecutar para repetirla.")
